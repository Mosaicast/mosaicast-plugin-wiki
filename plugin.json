{
  "id": "wiki",
  "version": "0.6.2",
  "platformApi": "0.19.1",
  "name": "Wiki",
  "license": "AGPL-3.0-or-later",
  "author": "The Mosaicast Authors",
  "homepage": "https://github.com/Mosaicast/mosaicast-plugin-wiki",
  "backend": {
    "basePath": "/api/plugins/wiki",
    "extensions": [
      "dev.mosaicast.plugin.wiki.WikiPlugin"
    ]
  },
  "frontend": {
    "entry": "wiki.es.js",
    "elements": [
      "wiki-page",
      "wiki-site-card",
      "wiki-episode-mentions"
    ]
  },
  "slots": [
    {
      "scope": "site",
      "element": "wiki-page",
      "placement": "page",
      "visibleTo": "anonymous",
      "order": 100
    },
    {
      "scope": "site",
      "element": "wiki-site-card",
      "placement": "site",
      "visibleTo": "anonymous",
      "order": 200
    },
    {
      "scope": "episode",
      "element": "wiki-episode-mentions",
      "placement": "main",
      "visibleTo": "anonymous",
      "order": 200
    }
  ],
  "nav": [
    {
      "path": "",
      "label": "Wiki",
      "icon": "book",
      "visibleTo": "anonymous"
    },
    {
      "path": "_all",
      "label": "All wiki pages",
      "icon": "list",
      "visibleTo": "anonymous"
    },
    {
      "path": "_random",
      "label": "Random wiki page",
      "icon": "dice",
      "visibleTo": "anonymous"
    },
    {
      "path": "_new",
      "label": "New wiki page",
      "icon": "compose",
      "visibleTo": "podcaster"
    }
  ],
  "storage": {
    "schema": {
      "page": {
        "slug": "string:indexed:unique",
        "title": "string",
        "summary": "text",
        "markdown": "text",
        "searchText": "text:fulltext",
        "tags": "string:indexed",
        "status": "string:indexed",
        "sourcesHeading": "string",
        "locale": "string:indexed",
        "translationOf": "string:indexed",
        "createdAt": "timestamp",
        "updatedAt": "timestamp:indexed",
        "updatedBy": "string",
        "revisionNo": "integer"
      },
      "revision": {
        "pageSlug": "string:indexed",
        "revisionNo": "integer",
        "title": "string",
        "markdown": "text",
        "comment": "string",
        "author": "string",
        "createdAt": "timestamp:indexed"
      },
      "link": {
        "fromSlug": "string:indexed",
        "toSlug": "string:indexed",
        "kind": "string:indexed",
        "label": "string"
      },
      "source": {
        "pageSlug": "string:indexed",
        "label": "string",
        "url": "text",
        "note": "text",
        "accessedAt": "timestamp",
        "position": "integer"
      },
      "media": {
        "pageSlug": "string:indexed",
        "url": "text",
        "kind": "string:indexed",
        "provider": "string:indexed",
        "caption": "text",
        "position": "integer",
        "uploadRef": "string:indexed"
      }
    }
  },
  "data": {
    "readableBy": "anonymous",
    "writableBy": "podcaster",
    "backendOwned": [
      "index",
      "home",
      "wikistats",
      "ingest:*"
    ],
    "keyFloors": [
      { "keys": ["draft:*", "delete:*", "ingest:*", "asset:*"], "readableBy": "podcaster" }
    ]
  },
  "blobs": {
    "maxFileBytes": 5242880,
    "quotaBytes": 268435456,
    "mimeTypes": [
      "image/png",
      "image/jpeg",
      "image/webp",
      "image/gif",
      "application/pdf"
    ]
  },
  "external": {
    "kinds": ["translation"],
    "usedBy": "podcaster"
  },
  "identity": {
    "resolvesUsers": true
  },
  "tags": {
    "readsVocabulary": true,
    "writesEpisodes": false
  },
  "config": {
    "homePageSlug": {
      "type": "string",
      "default": "main-page",
      "editableBy": "podcaster",
      "label": { "en": "Front page", "de": "Startseite" },
      "description": {
        "en": "The slug of the page shown as the wiki's front page. It's a normal page with history and an editor. If no page has this slug, the front page shows only the generated sections.",
        "de": "Der Slug der Seite, die als Startseite des Wikis dient. Sie ist eine normale Seite mit Verlauf und Editor. Gibt es keine Seite mit diesem Slug, zeigt die Startseite nur die erzeugten Abschnitte."
      }
    },
    "ingestIntervalSeconds": {
      "type": "number",
      "default": 30,
      "editableBy": "podcaster",
      "min": 1,
      "max": 86400,
      "step": 1,
      "label": { "en": "Ingest interval (seconds)", "de": "Abrufintervall (Sekunden)" },
      "description": {
        "en": "Seconds between two save passes. A saved page shows up on the next pass, so authors wait up to this long. Changes apply within one interval.",
        "de": "Sekunden zwischen zwei Speicherläufen. Eine gespeicherte Seite erscheint beim nächsten Lauf, so lange warten Schreibende höchstens. Änderungen greifen innerhalb eines Intervalls."
      }
    },
    "revisionsKept": {
      "type": "number",
      "default": 50,
      "editableBy": "podcaster",
      "min": 1,
      "max": 10000,
      "step": 1,
      "label": { "en": "Revisions kept per page", "de": "Aufbewahrte Versionen je Seite" },
      "description": {
        "en": "How many revisions of a page are kept. Older ones are deleted on the next save pass, and you can't get them back.",
        "de": "Wie viele Versionen einer Seite aufbewahrt werden. Ältere werden beim nächsten Speicherlauf gelöscht und sind dann weg."
      }
    },
    "sourceHeadings": {
      "type": "string",
      "default": "sources,quellen",
      "editableBy": "podcaster",
      "label": { "en": "Sources headings", "de": "Quellen-Überschriften" },
      "description": {
        "en": "Headings that start a page's sources section, separated by commas, in any case. Add the word in your wiki's language: \"fuentes\" for \"## Fuentes\".",
        "de": "Überschriften, die den Quellenabschnitt einer Seite einleiten, mit Kommas getrennt, Groß- und Kleinschreibung egal. Ergänze das Wort in der Sprache deines Wikis: \"fuentes\" für \"## Fuentes\"."
      }
    },
    "blobGraceMinutes": {
      "type": "number",
      "default": 60,
      "editableBy": "podcaster",
      "min": 0,
      "max": 10080,
      "step": 1,
      "label": { "en": "Unused upload grace period (minutes)", "de": "Schonfrist für ungenutzte Uploads (Minuten)" },
      "description": {
        "en": "How long an upload that no page or library entry uses is kept before it's deleted.",
        "de": "Wie lange ein Upload, den keine Seite und kein Mediathek-Eintrag nutzt, erhalten bleibt, bevor er gelöscht wird."
      }
    }
  }
}
