{
  "id": "wiki",
  "version": "0.1.0",
  "platformApi": "0.9.1",
  "name": "Wiki",
  "license": "AGPL-3.0-or-later",
  "author": "The Mosaicast Authors",
  "homepage": "https://github.com/Mosaicast/mosaicast-plugin-wiki",
  "backend": {
    "basePath": "/api/plugins/wiki",
    "extensions": [
      "dev.mosaicast.plugin.wiki.WikiPlugin"
    ]
  },
  "frontend": {
    "entry": "wiki.es.js",
    "elements": [
      "wiki-page",
      "wiki-site-card",
      "wiki-episode-mentions"
    ]
  },
  "slots": [
    {
      "scope": "site",
      "element": "wiki-page",
      "placement": "page",
      "visibleTo": "anonymous",
      "order": 100
    },
    {
      "scope": "site",
      "element": "wiki-site-card",
      "placement": "site",
      "visibleTo": "anonymous",
      "order": 200
    },
    {
      "scope": "episode",
      "element": "wiki-episode-mentions",
      "placement": "main",
      "visibleTo": "anonymous",
      "order": 200
    }
  ],
  "nav": [
    {
      "path": "",
      "label": "Wiki",
      "icon": "book",
      "visibleTo": "anonymous"
    },
    {
      "path": "_all",
      "label": "All wiki pages",
      "icon": "list",
      "visibleTo": "anonymous"
    },
    {
      "path": "_random",
      "label": "Random wiki page",
      "icon": "dice",
      "visibleTo": "anonymous"
    },
    {
      "path": "_new",
      "label": "New wiki page",
      "icon": "compose",
      "visibleTo": "podcaster"
    }
  ],
  "storage": {
    "schema": {
      "page": {
        "slug": "string:indexed:unique",
        "title": "string",
        "summary": "text",
        "markdown": "text",
        "searchText": "text:fulltext",
        "tags": "string:indexed",
        "status": "string:indexed",
        "createdAt": "timestamp",
        "updatedAt": "timestamp:indexed",
        "updatedBy": "string",
        "revisionNo": "integer"
      },
      "revision": {
        "pageSlug": "string:indexed",
        "revisionNo": "integer",
        "title": "string",
        "markdown": "text",
        "comment": "string",
        "author": "string",
        "createdAt": "timestamp:indexed"
      },
      "link": {
        "fromSlug": "string:indexed",
        "toSlug": "string:indexed",
        "kind": "string:indexed",
        "label": "string"
      },
      "source": {
        "pageSlug": "string:indexed",
        "label": "string",
        "url": "text",
        "note": "text",
        "accessedAt": "timestamp",
        "position": "integer"
      },
      "media": {
        "pageSlug": "string:indexed",
        "url": "text",
        "kind": "string:indexed",
        "provider": "string:indexed",
        "caption": "text",
        "position": "integer",
        "uploadRef": "string:indexed"
      }
    }
  },
  "data": {
    "readableBy": "anonymous",
    "writableBy": "podcaster",
    "backendOwned": [
      "index",
      "wikistats",
      "ingest:*"
    ]
  },
  "blobs": {
    "maxFileBytes": 5242880,
    "quotaBytes": 268435456,
    "mimeTypes": [
      "image/png",
      "image/jpeg",
      "image/webp",
      "image/gif",
      "application/pdf"
    ]
  },
  "tags": {
    "readsVocabulary": true,
    "writesEpisodes": false
  },
  "config": {
    "ingestIntervalSeconds": {
      "type": "number",
      "default": 30,
      "editableBy": "podcaster"
    },
    "revisionsKept": {
      "type": "number",
      "default": 50,
      "editableBy": "podcaster"
    },
    "blobGraceMinutes": {
      "type": "number",
      "default": 60,
      "editableBy": "podcaster"
    }
  }
}
